<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <a class="footer-logo" href="/listings"><i class="fa-regular fa-compass" aria-hidden="true"></i> Wanderlust</a>
        <p>Find a place to stay. Make a trip worth remembering.</p>
      </div>
      <div class="footer-links">
        <h2>Explore</h2>
        <a href="/listings">Browse stays</a>
        <a href="/listings/new">List your place</a>
      </div>
      <div class="footer-links">
        <h2>Your account</h2>
        <% if(currUser) { %>
          <a href="/logout">Log out</a>
        <% } else { %>
          <a href="/login">Log in</a>
          <a href="/signup">Create an account</a>
        <% } %>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> Wanderlust</span>
      <span>Made for your next getaway <i class="fa-solid fa-heart" aria-hidden="true"></i></span>
    </div>
  </div>
</footer>
